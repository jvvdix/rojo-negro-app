{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-02",
	"name": "drinky-games",
	"routes": [
		{ "pattern": "drinkygames.jvvdix.es", "custom_domain": true }
	],
	"assets": {
		"directory": "./build/web",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	}
}
